frontend/expense-tracker/build/
frontend/expense-tracker/dist/

# --- Debugging & Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- System Files ---
.DS_Store
Thumbs.db
.vscode/
.idea/