# --- Dependencies ---
# This ignores node_modules in the root, frontend, and backend
node_modules/
backend/node_modules/
frontend/expense-tracker/node_modules/

# --- Environment Variables (Security) ---
.env
backend/.env
frontend/expense-tracker/.env
*.local

# --- Production Builds ---
